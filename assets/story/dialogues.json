{
  "version": 1,
  "sequences": {
    "intro": {
      "start": "0",
      "nodes": {
        "0": {
          "speaker": "narrator",
          "text": "Шатёр цирка. Представление подходит к концу.",
          "next": "1"
        },
        "1": {
          "speaker": "richard",
          "text": "",
          "choices": [
            {
              "text": "Поклониться",
              "next": "2",
              "set": {
                "opening_action": "bow"
              }
            },
            {
              "text": "Помаргивать зрителям",
              "next": "2",
              "set": {
                "opening_action": "wink"
              }
            },
            {
              "text": "Поднять трость",
              "next": "2",
              "set": {
                "opening_action": "cane"
              }
            }
          ],
          "next": "2"
        },
        "2": {
          "speaker": "richard",
          "text": "До скорой встречи!",
          "event": "applause",
          "next": "3"
        },
        "3": {
          "speaker": "narrator",
          "text": "Крыша купола немного обваливается. Зрители аплодируют не в такт. Некоторые продолжают хлопать, когда музыка уже остановилась.",
          "event": "roof_crack",
          "next": "4"
        },
        "4": {
          "speaker": "audience",
          "text": "Ещё раз.",
          "event": "audience",
          "next": "end"
        }
      }
    },
    "mordecai_news": {
      "start": "0",
      "nodes": {
        "0": {
          "speaker": "mordecai",
          "text": "А вот и наша звезда. Слышал новость?",
          "next": "1"
        },
        "1": {
          "speaker": "richard",
          "text": "",
          "choices": [
            {
              "text": "Какие?",
              "next": "2",
              "set": {
                "news_reply": "ask"
              }
            },
            {
              "text": "Мне всё равно.",
              "next": "2",
              "set": {
                "news_reply": "dismiss"
              }
            }
          ],
          "next": "2"
        },
        "2": {
          "speaker": "mordecai",
          "text": "У нас будет новый ведущий. Уже нашли.",
          "next": "3"
        },
        "3": {
          "speaker": "mordecai",
          "text": "Молодой, чистенький… настоящий человек. Публика оценит.",
          "next": "4"
        },
        "4": {
          "speaker": "richard",
          "text": "И что?",
          "next": "5"
        },
        "5": {
          "speaker": "mordecai",
          "text": "А тебе оставят место в программе. Среди артистов.",
          "next": "6"
        },
        "6": {
          "speaker": "mordecai",
          "text": "Наконец-то, правда? Иди смой грим. Твоя комната — за афишами, рядом со мной.",
          "next": "end"
        }
      }
    },
    "mirror": {
      "start": "0",
      "nodes": {
        "0": {
          "speaker": "narrator",
          "text": "В зеркале нет отражения. Только пустая поверхность.",
          "event": "mirror_empty",
          "pause": 1.8,
          "next": "1"
        },
        "1": {
          "speaker": "narrator",
          "text": "Отражение появляется. Но оно улыбается раньше тебя.",
          "event": "mirror_scare",
          "pause": 0.6,
          "next": "2"
        },
        "2": {
          "speaker": "richard",
          "text": "Мне нужно выбираться отсюда...",
          "next": "end"
        }
      }
    },
    "elsa_dressing": {
      "start": "0",
      "nodes": {
        "0": {
          "speaker": "elsa",
          "text": "Тише, Ричард. Я здесь. Через главный вход не выйдешь.",
          "next": "1"
        },
        "1": {
          "speaker": "richard",
          "text": "А ты пробовала?",
          "next": "2"
        },
        "2": {
          "speaker": "elsa",
          "text": "Наверху есть старый технический выход. Мордекай с Бруно знают, что там случилось. Но сначала проверь свою коробку посреди манежа… внутри кто-то шуршит.",
          "next": "end"
        }
      }
    },
    "lili": {
      "start": "0",
      "nodes": {
        "0": {
          "speaker": "lili",
          "text": "Тс-с! Я спряталась! А ты тоже собираешься убежать?",
          "event": "lili_appears",
          "next": "1"
        },
        "1": {
          "speaker": "richard",
          "text": "Лили? Почему ты в моей коробке для фокусов?",
          "next": "2"
        },
        "2": {
          "speaker": "richard",
          "text": "",
          "choices": [
            {
              "text": "Да. Я собираюсь уйти.",
              "next": "leave",
              "set": {
                "wants_leave": true
              }
            },
            {
              "text": "Я никуда не уйду.",
              "next": "stay",
              "set": {
                "wants_leave": false
              }
            }
          ],
          "next": "3"
        },
        "leave": {
          "speaker": "lili",
          "text": "Но мы ещё не доиграли! Уйдёшь — кто будет тебя искать?",
          "next": "leave_choice"
        },
        "leave_choice": {
          "speaker": "richard",
          "text": "",
          "choices": [
            {
              "text": "Я не знаю, что именно со мной будет, когда придёт новый ведущий. А я... не горю желанием выступать в цирке не в роли ведущего.",
              "next": "lili_end",
              "set": {
                "wants_leave": true
              }
            },
            {
              "text": "Я... Передумал. Останусь.",
              "next": "stay",
              "set": {
                "wants_leave": false
              }
            }
          ],
          "next": "5"
        },
        "stay": {
          "speaker": "lili",
          "text": "Вот и хорошо! Сегодня ты красивый. А потом мы сделаем тебя ещё красивее.",
          "next": "repair"
        },
        "repair": {
          "speaker": "richard",
          "text": "Ты же отвечаешь за страховку в номерах? Я видел, крыша на ремонте, я же могу помочь?",
          "next": "refusal"
        },
        "refusal": {
          "speaker": "lili",
          "text": "Хи-хи. Нет! На крышу НЕЛЬЗЯ. Это правило!",
          "next": "lili_end"
        },
        "lili_end": {
          "speaker": "narrator",
          "text": "Лили спрыгивает с коробки и исчезает между кулисами. На крышке — RICHARD. Со стороны снарядов слышен голос Мордекая.",
          "next": "mordecai_calls",
          "event": "lili_leaves"
        },
        "mordecai_calls": {
          "speaker": "mordecai",
          "text": "Ричард! Прятки закончились? Подойди ко мне, к снарядам. Мы с Бруно как раз говорим о крыше.",
          "next": "end"
        }
      }
    },
    "mordecai_bruno": {
      "start": "0",
      "nodes": {
        "0": {
          "speaker": "bruno",
          "text": "Угу. Слышал.",
          "next": "1"
        },
        "1": {
          "speaker": "mordecai",
          "text": "Новый ведущий ещё даже не вышел на арену, а я уже устал от его лица. Талант, согласись.",
          "next": "2"
        },
        "2": {
          "speaker": "bruno",
          "text": "Мгм.",
          "next": "3"
        },
        "3": {
          "speaker": "mordecai",
          "text": "Ричард? Что, тоже соскучился по нашей компании?",
          "next": "4"
        },
        "4": {
          "speaker": "richard",
          "text": "Ээ... Я бы хотел узнать, могу ли помочь с ремонтом на крыше?",
          "next": "5"
        },
        "5": {
          "speaker": "mordecai",
          "text": "На крыше?",
          "next": "6"
        },
        "6": {
          "speaker": "richard",
          "text": "Да. Я видел, что там всё ещё не закончили ремонт.",
          "next": "7"
        },
        "7": {
          "speaker": "mordecai",
          "text": "И ты решил помочь?",
          "next": "8"
        },
        "8": {
          "speaker": "richard",
          "text": "Ну... да.",
          "next": "9"
        },
        "9": {
          "speaker": "mordecai",
          "text": "Как трогательно. Ричард решил позаботиться о цирке.",
          "next": "10"
        },
        "10": {
          "speaker": "bruno",
          "text": "Не лезь.",
          "next": "11"
        },
        "11": {
          "speaker": "richard",
          "text": "Что?",
          "next": "12"
        },
        "12": {
          "speaker": "bruno",
          "text": "Крыша гнилая. Не выдержит.",
          "next": "13"
        },
        "13": {
          "speaker": "mordecai",
          "text": "Он просто хочет помочь.",
          "next": "14"
        },
        "14": {
          "speaker": "mordecai",
          "text": "Правда ведь?",
          "next": "15"
        },
        "15": {
          "speaker": "richard",
          "text": "",
          "choices": [
            {
              "text": "Просто хочу посмотреть.",
              "next": "look",
              "set": {
                "roof_reply": "look"
              }
            },
            {
              "text": "Мне нужен доступ на крышу.",
              "next": "access",
              "set": {
                "roof_reply": "access"
              }
            }
          ],
          "next": "16"
        },
        "look": {
          "speaker": "richard",
          "text": "Просто хочу посмотреть.",
          "next": "look_roof"
        },
        "look_roof": {
          "speaker": "mordecai",
          "text": "На крышу?",
          "next": "look_yes"
        },
        "look_yes": {
          "speaker": "richard",
          "text": "Да.",
          "next": "look_of_course"
        },
        "look_of_course": {
          "speaker": "mordecai",
          "text": "Конечно.",
          "next": "look_walter"
        },
        "look_walter": {
          "speaker": "bruno",
          "text": "Вальтер решает. Эльза у служебной двери. Спроси её.",
          "next": "end"
        },
        "access": {
          "speaker": "richard",
          "text": "Мне нужен доступ на крышу.",
          "next": "access_why"
        },
        "access_why": {
          "speaker": "mordecai",
          "text": "Зачем?",
          "next": "access_repair"
        },
        "access_repair": {
          "speaker": "richard",
          "text": "Хочу проверить состояние конструкции.",
          "next": "access_of_course"
        },
        "access_of_course": {
          "speaker": "mordecai",
          "text": "А-а. Конечно.",
          "next": "access_walter"
        },
        "access_walter": {
          "speaker": "mordecai",
          "text": "Сначала получи благословение Вальтера. Эльза как раз у служебной двери.",
          "next": "access_pause"
        },
        "access_pause": {
          "speaker": "mordecai",
          "text": "И...",
          "next": "access_warning"
        },
        "access_warning": {
          "speaker": "mordecai",
          "text": "Не прыгай. Публика сегодня уже разошлась.",
          "next": "end"
        }
      }
    },
    "elsa_hall": {
      "start": "0",
      "nodes": {
        "0": {
          "speaker": "elsa",
          "text": "Я слышала. Теперь тебе нужен Вальтер.",
          "next": "1"
        },
        "1": {
          "speaker": "richard",
          "text": "Доступ на крышу?",
          "next": "2"
        },
        "2": {
          "speaker": "elsa",
          "text": "Вальтер.",
          "next": "3"
        },
        "3": {
          "speaker": "richard",
          "text": "Где его найти?",
          "next": "4"
        },
        "4": {
          "speaker": "elsa",
          "text": "В конце этого коридора. Комната без занавесок.",
          "next": "5"
        },
        "5": {
          "speaker": "richard",
          "text": "Почему ты называешь её пыточной?",
          "next": "6"
        },
        "6": {
          "speaker": "elsa",
          "text": "Увидишь сам. Возьми невидимку — подцепи язычок замка. Только тихо.",
          "next": "7"
        },
        "7": {
          "speaker": "narrator",
          "text": "Эльза даёт тебе невидимку.",
          "event": "hairpin_received",
          "next": "end"
        }
      }
    },
    "technical": {
      "start": "0",
      "nodes": {
        "0": {
          "speaker": "narrator",
          "text": "Технический туннель. Здесь нет афиш. Лампочки периодически мигают.",
          "event": "technical_begin",
          "next": "walk"
        },
        "1": {
          "speaker": "narrator",
          "text": "СТУК.",
          "event": "knock_front",
          "pause": 0.7,
          "next": "2"
        },
        "2": {
          "speaker": "narrator",
          "text": "Ты оглядываешься. Ничего.",
          "next": "3"
        },
        "3": {
          "speaker": "narrator",
          "text": "СТУК. Теперь звук уже позади.",
          "event": "knock_behind",
          "pause": 0.7,
          "next": "4"
        },
        "4": {
          "speaker": "narrator",
          "text": "В конце туннеля на секунду появляется силуэт Лили. Свет моргает. Её нет.",
          "event": "lili_silhouette",
          "pause": 0.6,
          "next": "end"
        },
        "walk": {
          "speaker": "richard",
          "text": "",
          "choices": [
            {
              "text": "Идти дальше",
              "next": "1"
            },
            {
              "text": "Оглянуться",
              "next": "look_back",
              "set": {
                "looked_back": true
              }
            }
          ]
        },
        "look_back": {
          "speaker": "narrator",
          "text": "Позади никого. Тишина.",
          "next": "walk"
        }
      }
    },
    "photos": {
      "start": "0",
      "nodes": {
        "0": {
          "speaker": "narrator",
          "text": "Комната неожиданно чистая. На стене фотографии артистов: «ДО» и «ПОСЛЕ».",
          "next": "1"
        },
        "1": {
          "speaker": "narrator",
          "text": "Обычный мужчина. Бруно. Эльза. Лили.",
          "event": "show_photos",
          "next": "wall"
        },
        "2": {
          "speaker": "narrator",
          "text": "Последняя фотография закрыта. Ты снимаешь её.",
          "next": "3"
        },
        "3": {
          "speaker": "narrator",
          "text": "Под ней — фотография тебя самого. Моложе. Без костюма ведущего. Подпись: РЕБЁНОК.",
          "event": "richard_photo",
          "next": "4"
        },
        "4": {
          "speaker": "narrator",
          "text": "Фотография падает на пол.",
          "event": "photo_falls",
          "next": "end"
        },
        "wall": {
          "speaker": "narrator",
          "text": "Фотографии на стене. Кого ты хочешь рассмотреть?",
          "choices": [
            {
              "text": "Бруно — «ДО / ПОСЛЕ»",
              "next": "bruno_photo"
            },
            {
              "text": "Эльза — «ДО / ПОСЛЕ»",
              "next": "elsa_photo"
            },
            {
              "text": "Лили — «ДО / ПОСЛЕ»",
              "next": "lili_photo"
            },
            {
              "text": "Снять закрытую фотографию",
              "next": "2"
            }
          ]
        },
        "bruno_photo": {
          "speaker": "narrator",
          "portrait": "bruno",
          "text": "Бруно. «ДО»: обычный мужчина. «ПОСЛЕ»: силач.",
          "next": "wall"
        },
        "elsa_photo": {
          "speaker": "narrator",
          "portrait": "elsa",
          "text": "Эльза. «ДО» и «ПОСЛЕ». Теперь она всегда в воздухе.",
          "next": "wall"
        },
        "lili_photo": {
          "speaker": "narrator",
          "portrait": "lili",
          "text": "Лили. «ДО» и «ПОСЛЕ». Ты только что говорил с ней.",
          "next": "wall"
        }
      }
    },
    "walter_arrival": {
      "start": "0",
      "nodes": {
        "0": {
          "speaker": "walter",
          "text": "Положите фотографию на место. Края легко повредить.",
          "event": "walter_appears",
          "next": "1"
        },
        "1": {
          "speaker": "walter",
          "text": "Теперь повернитесь ко мне, Ричард.",
          "next": "end"
        }
      }
    },
    "bruno_idle": {
      "start": "0",
      "nodes": {
        "0": {
          "speaker": "bruno",
          "text": "...",
          "next": "end"
        }
      }
    }
  }
}
